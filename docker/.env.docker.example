# PostgreSQL & PgBouncer Configuration
POSTGRES_DB=digipass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# Connection Strings for DigiPass backend (.env):
# DATABASE_URL: Connects through PgBouncer connection pool (port 6432)
# DIRECT_URL: Direct Postgres connection (port 5432) for migrations & Prisma CLI
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:6432/digipass?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/digipass?schema=public"
