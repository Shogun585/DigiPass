PORT="8000"

# PostgreSQL connection URLs (connection pooling & direct)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:6432/digipass?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/digipass?schema=public"

# Neon Object Storage (S3-compatible for student photos)
# Obtain these from your Neon Console under Object Storage settings
NEON_STORAGE_ENDPOINT="https://<branch-id>.<region>.aws.neon.tech"
NEON_ACCESS_KEY_ID="nak_your_neon_access_key_id"
NEON_SECRET_ACCESS_KEY="your_neon_secret_access_key"
NEON_STORAGE_BUCKET="student-photos"
NEON_STORAGE_REGION="us-east-1"

# Legacy Supabase Storage (Fallback during migration)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

SECRET_KEY="your_jwt_secret_key"
DEFAULT_PASSWORD="your_default_user_password"
BASE_URL="http://localhost:8000"
ORIGIN="http://localhost:5173"
